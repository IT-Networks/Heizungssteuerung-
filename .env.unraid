# Unraid Configuration
# Copy this to .env and adjust values

# ===========================================
# APPDATA PATH (Unraid standard path)
# ===========================================
APPDATA_PATH=/mnt/user/appdata/heizungssteuerung

# ===========================================
# PORT CONFIGURATION
# ===========================================
BACKEND_PORT=3001
FRONTEND_PORT=3000

# Optional: Set API URL if frontend runs on different host
# VITE_API_URL=http://your-unraid-ip:3001

# ===========================================
# CHURCHTOOLS CONFIGURATION
# ===========================================
CHURCHTOOLS_URL=https://your-church.church.tools
CHURCHTOOLS_LOGIN_TOKEN=your-login-token-here

# ===========================================
# DANFOSS ALLY CONFIGURATION
# ===========================================
DANFOSS_API_KEY=your-api-key
DANFOSS_API_SECRET=your-api-secret

# ===========================================
# APPLICATION SETTINGS
# ===========================================
NODE_ENV=production
SCHEDULER_INTERVAL_MINUTES=5
DEFAULT_PREHEAT_MINUTES=30
DEFAULT_IDLE_TEMPERATURE=160
