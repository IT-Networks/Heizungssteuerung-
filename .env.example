# ChurchTools Configuration
CHURCHTOOLS_URL=https://your-instance.church.tools
CHURCHTOOLS_LOGIN_TOKEN=your-login-token-here

# Danfoss Ally Configuration
DANFOSS_API_KEY=your-danfoss-api-key
DANFOSS_API_SECRET=your-danfoss-api-secret

# Application Settings
PORT=3001
NODE_ENV=production
SCHEDULER_INTERVAL_MINUTES=5
DEFAULT_PREHEAT_MINUTES=30
DEFAULT_IDLE_TEMPERATURE=160

# Monitoring (weitere Einstellungen in der Web-UI unter "Einstellungen")
# MAX_HEATING_DURATION_MINUTES=180
# BATTERY_WARNING_THRESHOLD=20
# BATTERY_CRITICAL_THRESHOLD=10
