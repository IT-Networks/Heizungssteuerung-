# ChurchTools Configuration
CHURCHTOOLS_URL=https://your-church.church.tools
CHURCHTOOLS_LOGIN_TOKEN=your-login-token

# Danfoss Ally Configuration
DANFOSS_API_KEY=your-danfoss-api-key
DANFOSS_API_SECRET=your-danfoss-api-secret

# Application Settings
PORT=3001
NODE_ENV=development
DATA_PATH=./data

# Scheduler Settings
SCHEDULER_INTERVAL_MINUTES=5
DEFAULT_PREHEAT_MINUTES=30
DEFAULT_IDLE_TEMPERATURE=160
